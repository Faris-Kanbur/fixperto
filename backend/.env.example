PORT=4000
FIXPERTO_ADMIN_EMAIL=admin@fixperto.com
FIXPERTO_ADMIN_PASSWORD=Fixperto2026!
# Prodüksiyonda MUTLAKA gerçek frontend domain'inizle set edin (virgülle birden fazla değer
# verilebilir, ör. "https://fixperto.com,https://www.fixperto.com"). Boş bırakılırsa (yerel
# geliştirme için) sadece localhost originlerine izin verilir — internetteki başka hiçbir site
# API'ye tarayıcı üzerinden istek atamaz.
FIXPERTO_ALLOWED_ORIGINS=

# GERÇEK OTURUM SİSTEMİ: kayıt (otomatik şifre) ve giriş (OTP) e-postaları bu SMTP bilgisiyle
# gönderiliyor (bkz. backend/utils/mailer.js). Ayarlanmazsa mail gönderilmez, içerik konsola
# yazılır ve NODE_ENV=production DEĞİLSE üretilen şifre/kod API yanıtında da (devPassword/devOtp)
# döner ki yerel geliştirmede SMTP kurmadan test edilebilsin. FIXPERTO_SMTP_PASS bir Gmail
# "Uygulama Şifresi" (App Password) olmalı — normal Gmail hesap şifresi Google tarafından SMTP
# için reddedilir (özellikle 2 Adımlı Doğrulama açıksa, ki App Password üretmek için zaten gerekli).
# App Password oluşturmak için: Google Hesabı -> Güvenlik -> 2 Adımlı Doğrulama -> Uygulama Şifreleri.
FIXPERTO_SMTP_HOST=smtp.gmail.com
FIXPERTO_SMTP_PORT=587
FIXPERTO_SMTP_USER=you@gmail.com
FIXPERTO_SMTP_PASS=xxxx xxxx xxxx xxxx
FIXPERTO_MAIL_FROM=you@gmail.com
